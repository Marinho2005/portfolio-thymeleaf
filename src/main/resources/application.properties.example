spring.application.name=demo

# Supabase configuration — preencha com SEUS valores
# Copie este arquivo para application.properties e preencha.
# application.properties esta no .gitignore e NAO deve ir pro GitHub.
supabase.url=SUA_URL_SUPABASE
supabase.key=SUA_SUPABASE_KEY

# PostgreSQL Datasource Configuration for Supabase (Session Pooler)
spring.datasource.url=jdbc:postgresql://SEU_HOST_POOLER:5432/postgres?sslmode=require
spring.datasource.username=SEU_USUARIO
spring.datasource.password=SUA_SENHA
spring.datasource.driver-class-name=org.postgresql.Driver

# Flyway Configuration (desabilitado temporariamente devido a compatibilidade com Session Pooler)
spring.flyway.enabled=false
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.out-of-order=false
